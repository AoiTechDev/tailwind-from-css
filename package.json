{
  "name": "tailwind-from-css",
  "version": "0.2.0",
  "description": "Convert CSS and computed styles to Tailwind CSS v4 classes, exactly. Verified against your own Tailwind theme.",
  "license": "MIT",
  "author": "Paweł Bornikowski",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tailwind-from-css": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "node scripts/gen-css-data.ts",
    "gen:check": "node scripts/gen-css-data.ts --check",
    "check": "biome check . && tsc --noEmit && knip",
    "test": "vitest run --project unit --project contract --project golden --project property --project types",
    "test:coverage": "vitest run --project unit --project contract --project golden --project property --coverage",
    "test:golden": "vitest run --project golden",
    "test:differential": "vitest run --project differential",
    "test:e2e": "vitest run --project e2e",
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack . --profile esm-only && vitest run --project e2e",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "tailwindcss": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AoiTechDev/tailwind-from-css.git"
  },
  "bugs": "https://github.com/AoiTechDev/tailwind-from-css/issues",
  "homepage": "https://github.com/AoiTechDev/tailwind-from-css#readme",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "css",
    "converter",
    "css-to-tailwind",
    "codegen",
    "design-to-code"
  ],
  "packageManager": "pnpm@10.34.6",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "mdn-data": "2.37.2",
    "publint": "0.3.25",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0"
  }
}
