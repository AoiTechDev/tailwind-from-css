{
  "source": "Bootstrap 5.3.8 utilities (bootstrap, dist/css/bootstrap-utilities.css, MIT, vendored in golden real-world/), no reboot; page written for the suite; captured in headless Edge 155 over CDP at 375, 768 and 1280 × 800 (desktop, light scheme), states forced with CSS.forcePseudoState; baseline = Tailwind 4.3.3 theme + Preflight inside a copy of the parent's computed style",
  "page": [
    "<div id=\"layout\" class=\"d-flex flex-column flex-md-row gap-3 p-3 p-md-4\">",
    "    <aside id=\"sidebar\" class=\"d-none d-md-block flex-shrink-0 border-end pe-4\">",
    "      <a id=\"side-link\" class=\"d-block py-1 link-body-emphasis link-offset-2 link-underline-opacity-0 link-underline-opacity-75-hover\" href=\"#overview\">Overview</a>",
    "    </aside>",
    "    <main id=\"main\" class=\"flex-grow-1\">",
    "      <h1 id=\"title\" class=\"fs-3 fw-semibold mb-2 text-center text-md-start\">System status</h1>",
    "      <p id=\"summary\" class=\"text-body-secondary lh-sm mb-4\">All systems operational. <span id=\"badge\" class=\"d-inline-block px-2 rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle small\">Live</span></p>",
    "      <div id=\"panel\" class=\"position-relative border rounded-3 shadow-sm p-3 bg-body-tertiary\">",
    "        <span id=\"dot\" class=\"position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle\"></span>",
    "        <p id=\"metric\" class=\"font-monospace fs-5 mb-1 text-truncate\">uptime 99.982%</p>",
    "        <a id=\"details\" class=\"focus-ring py-1 px-2 rounded text-decoration-none link-primary\" href=\"#details\">View details</a>",
    "      </div>",
    "    </main>",
    "  </div>"
  ],
