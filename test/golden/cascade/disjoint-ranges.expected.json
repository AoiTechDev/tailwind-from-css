{
  "rules": [
    {
      "subject": ".nav",
      "selectors": [
        ".nav"
      ],
      "className": "max-md:hidden md:flex",
      "mappings": [
        [
          "max-md:hidden",
          "named",
          "6:10 | @media (width < 48rem) | display: none"
        ],
        [
          "md:flex",
          "named",
          "2:10 | @media (min-width: 768px) | display: flex"
        ]
      ],
      "unconverted": [],
      "diagnostics": [],
      "exact": true
    }
  ],
  "passthroughCss": "",
  "diagnostics": []
}
